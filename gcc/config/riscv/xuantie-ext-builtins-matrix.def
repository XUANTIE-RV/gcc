#ifndef DEF_RVM_I_OPS
#define DEF_RVM_I_OPS(TYPE, REQUIRE)
#endif

/* Use "DEF_RVM_U_OPS" macro include all unsigned integer which will be
   iterated and registered as intrinsic functions.  */
#ifndef DEF_RVM_U_OPS
#define DEF_RVM_U_OPS(TYPE, REQUIRE)
#endif

#ifndef DEF_RVM_F_OPS
#define DEF_RVM_F_OPS(TYPE, REQUIRE)
#endif

#ifndef DEF_RVM_M2_OPS
#define DEF_RVM_M2_OPS(TYPE, REQUIRE)
#endif

#ifndef DEF_RVM_SI_OPS
#define DEF_RVM_SI_OPS(TYPE, REQUIRE)
#endif

DEF_RVM_I_OPS (mint8_t, 2)
DEF_RVM_I_OPS (mint16_t, 2)
DEF_RVM_I_OPS (mint32_t, 2)
DEF_RVM_I_OPS (mint64_t, 2)

DEF_RVM_U_OPS (muint8_t, 2)
DEF_RVM_U_OPS (muint16_t, 2)
DEF_RVM_U_OPS (muint32_t, 2)
DEF_RVM_U_OPS (muint64_t, 2)

DEF_RVM_F_OPS (mfloat16_t, 2)
DEF_RVM_F_OPS (mfloat32_t, 2)
DEF_RVM_F_OPS (mfloat64_t, 2)

DEF_RVM_SI_OPS (mint32_t, 2)

DEF_RVM_M2_OPS (mint8x2_t, 2)
DEF_RVM_M2_OPS (mint16x2_t, 2)
DEF_RVM_M2_OPS (mint32x2_t, 2)
DEF_RVM_M2_OPS (mint64x2_t, 2)
DEF_RVM_M2_OPS (muint8x2_t, 2)
DEF_RVM_M2_OPS (muint16x2_t, 2)
DEF_RVM_M2_OPS (muint32x2_t, 2)
DEF_RVM_M2_OPS (muint64x2_t, 2)
DEF_RVM_M2_OPS (mfloat16x2_t, 2)
DEF_RVM_M2_OPS (mfloat32x2_t, 2)
DEF_RVM_M2_OPS (mfloat64x2_t, 2)

#undef DEF_RVM_SI_OPS
#undef DEF_RVM_I_OPS
#undef DEF_RVM_U_OPS
#undef DEF_RVM_F_OPS
#undef DEF_RVM_M2_OPS

/* Use "DEF_RVM_BASE_TYPE" macro to define RVM base types.
   The 'NAME' will be concatenated into intrinsic function name.  */
#ifndef DEF_RVM_BASE_TYPE
#define DEF_RVM_BASE_TYPE(NAME, TYPE)
#endif

DEF_RVM_BASE_TYPE (matrix, builtin_types[type_index].matrix)
DEF_RVM_BASE_TYPE (scalar, builtin_types[type_index].scalar)
DEF_RVM_BASE_TYPE (scalar_ptr, builtin_types[type_index].scalar_ptr)
DEF_RVM_BASE_TYPE (scalar_const_ptr,
		   builtin_types[type_index].scalar_const_ptr)
DEF_RVM_BASE_TYPE (void, void_type_node)
DEF_RVM_BASE_TYPE (size_t, size_type_node)
DEF_RVM_BASE_TYPE (unsigned_matrix, builtin_types[type_index + 1].matrix)
DEF_RVM_BASE_TYPE (unsigned_scalar, builtin_types[type_index + 1].scalar)

DEF_RVM_BASE_TYPE (mtrunc, builtin_types[type_index - NUM_RVM_TYPE / 2].matrix)

#undef DEF_RVM_BASE_TYPE

#ifndef DEF_RVM_OP_TYPE
#define DEF_RVM_OP_TYPE(NAME)
#endif

DEF_RVM_OP_TYPE (mm)
DEF_RVM_OP_TYPE (mv)
DEF_RVM_OP_TYPE (m_x)
DEF_RVM_OP_TYPE (x_m)

#undef DEF_RVM_OP_TYPE