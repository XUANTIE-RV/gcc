#endif

ENTRY (RVMM1QI, TARGET_XTHEADMATRIX, 1)
ENTRY (RVMM1HI, TARGET_XTHEADMATRIX, 1)
ENTRY (RVMM1SI, TARGET_XTHEADMATRIX, 1)
ENTRY (RVMM1DI, TARGET_XTHEADMATRIX, 1)
ENTRY (RVMM1HF, TARGET_XTHEADMATRIX, 1)
ENTRY (RVMM1SF, TARGET_XTHEADMATRIX, 1)
ENTRY (RVMM1DF, TARGET_XTHEADMATRIX, 1)

